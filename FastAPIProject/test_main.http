# Test your FastAPI endpoints
# 所有接口（含异常）均返回统一格式：{"code": 0, "message": "success", "data": ...}
# 失败时 code 为 HTTP 状态码（404/422/500），data 可能包含错误详情
# 所有响应均带 X-Process-Time 头（计时中间件示例），值为服务端处理耗时（秒）

GET http://127.0.0.1:8000/
Accept: application/json

###

GET http://127.0.0.1:8000/hello/User
Accept: application/json

###

# 查询商品列表（查询参数：过滤 + 分页）
GET http://127.0.0.1:8000/items/?q=键盘&skip=0&limit=10
Accept: application/json

###

# 查询单个商品（路径参数）
GET http://127.0.0.1:8000/items/1
Accept: application/json

###

# 创建商品（请求体，201），成功后统一返回 {"code": 0, "message": "创建成功", "data": {...}}
# name 会自动去除首尾空白；tags 会去重（["电子产品", "电子产品", " 外设 "] -> ["电子产品", "外设"]）
# 写操作由依赖注入鉴权：必须携带 X-Token: secret
POST http://127.0.0.1:8000/items/
Content-Type: application/json
X-Token: secret

{
  "name": "无线鼠标",
  "price": 99.9,
  "tags": ["电子产品", "外设"]
}

###

# 创建商品失败示例：price <= 0 -> 422，data 中携带字段级错误详情
# （依赖先于请求体校验执行，令牌正确才会看到 422）
POST http://127.0.0.1:8000/items/
Content-Type: application/json
X-Token: secret

{
  "name": "鼠标",
  "price": -1
}

###

# 更新商品（仅更新传入字段）
PUT http://127.0.0.1:8000/items/1
Content-Type: application/json

{
  "price": 259.0
}

###

# 更新失败示例：空对象未提交任何字段 -> 422
PUT http://127.0.0.1:8000/items/1
Content-Type: application/json

{}

###

# 更新失败示例：显式传 null -> 422（不允许把已有字段置空）
PUT http://127.0.0.1:8000/items/1
Content-Type: application/json

{
  "name": null
}

###

# 删除商品（200，统一响应体；删除成功后 data 为 null）
DELETE http://127.0.0.1:8000/items/1
Accept: application/json

###

# 查询不存在的商品 -> 404，{"code": 404, "message": "商品不存在", "data": null}
GET http://127.0.0.1:8000/items/999
Accept: application/json

###

# 创建商品未携带令牌 -> 401，{"code": 401, "message": "无效的令牌", "data": null}
POST http://127.0.0.1:8000/items/
Content-Type: application/json

{
  "name": "无线鼠标",
  "price": 99.9
}

###

# CORS 预检请求（浏览器跨域前自动发送，由 CORSMiddleware 直接应答，不会到达路由）
# 响应头应包含 Access-Control-Allow-Origin: http://localhost:5173
OPTIONS http://127.0.0.1:8000/items/
Origin: http://localhost:5173
Access-Control-Request-Method: POST
Access-Control-Request-Headers: x-token

###

# 跨域简单请求：响应头带 Access-Control-Allow-Origin（可对照无 Origin 的请求）
GET http://127.0.0.1:8000/items/1
Origin: http://localhost:5173
Accept: application/json

###

# ---------- 文件上传 / 下载 / 静态资源 ----------

# 上传文件（multipart/form-data，表单字段名为 file，需携带令牌，201）
# 服务端校验：扩展名白名单、大小上限 5 MiB、落盘名 uuid_安全化原名
# 先在项目根目录准备一个 test.txt 再执行（< 后为本地文件路径）
POST http://127.0.0.1:8000/files/upload
X-Token: secret
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="测试文档.txt"
Content-Type: text/plain

< ./test.txt
--WebAppBoundary--

###

# 上传未携带令牌 -> 401（依赖注入鉴权）
POST http://127.0.0.1:8000/files/upload
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

< ./test.txt
--WebAppBoundary--

###

# 上传被拒绝的扩展名（如 .exe）-> 400，{"code": 400, "message": "不支持的扩展名 .exe ..."}
POST http://127.0.0.1:8000/files/upload
X-Token: secret
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="evil.exe"
Content-Type: application/octet-stream

< ./test.txt
--WebAppBoundary--

###

# 查询已上传文件（分页复用 Pagination 依赖；stored_name 可用于下方下载）
GET http://127.0.0.1:8000/files/?skip=0&limit=10
Accept: application/json

###

# 下载文件（文件流 + Content-Disposition: attachment，浏览器直接下载）
# 把 <stored_name> 替换为上传接口返回的 stored_name
GET http://127.0.0.1:8000/files/download/<stored_name>
Accept: application/octet-stream

###

# 路径穿越攻击示例（编码反斜杠）-> 400，{"code": 400, "message": "非法的文件名"}
GET http://127.0.0.1:8000/files/download/..%5Cmain.py
Accept: application/json

###

# 路径穿越攻击示例（编码斜杠）-> 404：%2F 解码出 "/" 后路径参数不匹配，路由层直接拦截
GET http://127.0.0.1:8000/files/download/..%2Fmain.py
Accept: application/json

###

# 下载不存在的文件 -> 404，{"code": 404, "message": "文件不存在"}
GET http://127.0.0.1:8000/files/download/not-exist.txt
Accept: application/json

###

# 静态资源直链：把任意文件放入 static/ 目录后，通过 /static/<文件名> 访问（无 ApiResponse 包装）
GET http://127.0.0.1:8000/static/<文件名>

###

# 上传文件的直链访问（内联展示，适合 <img src>；需下载请用 /files/download 接口）
GET http://127.0.0.1:8000/uploads/<stored_name>

###
